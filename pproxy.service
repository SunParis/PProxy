[Unit]
Description=PProxy selective HTTP/HTTPS forward proxy
Documentation=https://github.com/SunParis/PProxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.vpnvpn
ExecStart=%h/.vpnvpn/pproxy -listen 127.0.0.1:7895 -proxy http://127.0.0.1:7890 -list %h/.vpnvpn/DIRECT_LIST
Restart=on-failure
RestartSec=3s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
UMask=0077

[Install]
WantedBy=default.target
